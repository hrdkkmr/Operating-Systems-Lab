+// Follows waits_for edges from `start`; returns 1 if it comes back.
+static int
+cycle_from(struct board *b, int start)
+{
+  int cur, steps;
+
+  cur = start;
+  for(steps = 0; steps < 2; steps++){
+    if(b->state[cur] != ST_WAITING)
+      return 0;
+    cur = b->waits_for[cur];
+    if(cur == start)
+      return 1;
+  }
+  return 0;
+}
